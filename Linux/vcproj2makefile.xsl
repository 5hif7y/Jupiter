<?xml version="1.0"?><!-- =========================================================== --><!--                                                             --><!-- vcproj2makefile.xsl                                         --><!--                                                             --><!-- XSL transformation script to generate a makefile from a     --><!-- Visual Studio .NET 2003 C++ project (.vcproj) file.         --><!--                                                             --><!-- Usage: xsltproc vcproj2makefile.xsl <project file>          --><!--                                                             --><!-- (c) 2004 Monolith Productions, Inc. All Rights Reserved.    --><!-- (c) 2004 Touchdown Entertainment, Inc. All Rights Reserved. --><!--                                                             --> <!-- dlj - 11/04 convert to Jupiter add some defines change      --><!--       build paths, remove some windows libs etc             --><!--                                                             --><!-- =========================================================== --><xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform"><xsl:output method="text" /><!-- ========================================================= --><!-- main generation step				       --><!-- ========================================================= --><xsl:template match="VisualStudioProject">################################################################# Auto-generated makefile for <xsl:value-of select="@Name" />.## (c) 2004 Monolith Productions, Inc. All Rights Reserved.# (c) 2004 Touchdown Entertainment, Inc. All Rights Reserved.################################################################# Build toolsifeq "$(CPP_TOOL)" "" CPP_TOOL=g++endififeq "$(CC_TOOL)" ""CC_TOOL=gccendififeq "$(LIB_TOOL)" ""LIB_TOOL=arendififeq "$(EXE_TOOL)" ""EXE_TOOL=g++endif# Project nameProjectName=<xsl:value-of select="@Name" /># Set default configurationifeq "$(ConfigurationName)" ""ConfigurationName = Debugendif# Platform-specific variablesLINUX_DEFINES=-D_LINUX -D__LINUX -DDISABLE_LT_MEM_TRACKING -DNO_EXCEPTIONSHAVOK_INCLUDE_PATH=../../../libs/Havok23Linux/includeHAVOK_DEBUG_LIB_PATH=../../../libs/Havok23Linux/lib/unix-gcc/debugHAVOK_RELEASE_LIB_PATH=../../../libs/Havok23Linux/lib/unix-gcc/release# SourceFilesSOURCEFILES=<xsl:call-template name="sourceFiles" /># Object filesOBJECTFILES=<xsl:call-template name="objectFiles" /><xsl:call-template name="configurationBuilds" /></xsl:template><!-- ========================================================= --><!-- template: configurationBuilds							   --><!-- ========================================================= --><xsl:template name="configurationBuilds">	<xsl:for-each select="/VisualStudioProject/Configurations/Configuration[contains(@Name, 'Win32')]">################################################################ Configuration: <xsl:value-of select="substring-before(@Name, '|')" />###############################################################ifeq "$(ConfigurationName)" "<xsl:value-of select="substring-before(@Name, '|')" />"# Output and Intermediate directories for this configuration OutDir=<xsl:call-template name ="convertPath">	  <xsl:with-param name="text" select="translate(@OutputDirectory, '\', '/')" />       </xsl:call-template>IntDir=<xsl:call-template name="convertPath">          <xsl:with-param name="text" select="translate(@IntermediateDirectory,'\', '/')" />       </xsl:call-template># Defines, includes, and librariesDEFINES=$(LINUX_DEFINES) <xsl:call-template name="processDefines">       <xsl:with-param name="definesString" select="Tool[@Name='VCCLCompilerTool']/@PreprocessorDefinitions" />    </xsl:call-template>INCLUDES=-I. <xsl:call-template name="processIncludePaths">       <xsl:with-param name="includePathsString" select="Tool[@Name='VCCLCompilerTool']/@AdditionalIncludeDirectories" />    </xsl:call-template>LIBRARYPATHS=<xsl:call-template name="processLibraryPaths">       <xsl:with-param name="libraryPathsString" select="Tool[@Name='VCLinkerTool']/@AdditionalLibraryDirectories" />    </xsl:call-template>LIBRARIES=<xsl:call-template name="processLibraries">       <xsl:with-param name="librariesString" select="Tool[@Name='VCLinkerTool']/@AdditionalDependencies" />    </xsl:call-template># Compile options<xsl:variable name="RTTIOption" select="Tool[@Name='VCCLCompilerTool']/@RuntimeTypeInfo" /><xsl:choose>	<xsl:when test="$RTTIOption!='TRUE'">RTTI_OPTION=-fno-rtti	</xsl:when></xsl:choose><xsl:variable name="DebugOption" select="Tool[@Name='VCCLCompilerTool']/@DebugInformationFormat" /><xsl:choose>	<xsl:when test="$DebugOption!='0' and $DebugOption!=''">DEBUG_OPTION=-g	</xsl:when></xsl:choose>		# Compile and Link commandsCPP_COMPILE=$(CPP_TOOL) -c $(DEBUG_OPTION) -pthread -fno-exceptions $(RTTI_OPTION) -o "$(IntDir)/$(*F).o" $(DEFINES) $(INCLUDES)CC_COMPILE=$(CC_TOOL) -c $(DEBUG_OPTION) -pthread -o "$(IntDir)/$(*F).o" $(DEFINES) $(INCLUDES)<xsl:choose>    <xsl:when test="count(Tool[@Name='VCLibrarianTool'])>0">		<xsl:variable name="outputFile" select="Tool[@Name='VCLibrarianTool']/@OutputFile" />		<xsl:choose>			<xsl:when test="string-length($outputFile)>0">TargetPath=<xsl:call-template name="processTargetPath">				<xsl:with-param name="targetPath" select="$outputFile" />			</xsl:call-template>			</xsl:when>			<xsl:otherwise>TargetPath=$(OutDir)/$(ProjectName).a			</xsl:otherwise>		</xsl:choose>LINK=$(LIB_TOOL) -rs "$(TargetPath)" $(OBJECTFILES) $(LIBRARYPATHS) $(LIBRARIES)    </xsl:when>	<xsl:when test="count(Tool[@Name='VCLinkerTool'])>0 and ( contains(Tool[@Name='VCLinkerTool']/@OutputFile, '.dll') or contains(Tool[@Name='VCLinkerTool']/@OutputFile, '.lto') )">TargetPath=<xsl:call-template name="processTargetPath">				<xsl:with-param name="targetPath" select="Tool[@Name='VCLinkerTool']/@OutputFile" />			</xsl:call-template>LINK=$(EXE_TOOL) -rdynamic -pthread $(DEBUG_OPTION) -o "$(TargetPath)" -shared $(OBJECTFILES) $(LIBRARYPATHS) $(LIBRARIES)    </xsl:when>	<xsl:otherwise>TargetPath=<xsl:call-template name="processTargetPath">				<xsl:with-param name="targetPath" select="Tool[@Name='VCLinkerTool']/@OutputFile" />			</xsl:call-template>LINK=$(EXE_TOOL) -pthread $(DEBUG_OPTION) -o "$(TargetPath)" $(OBJECTFILES) $(LIBRARYPATHS) $(LIBRARIES)</xsl:otherwise></xsl:choose>MAKEDEPEND=<![CDATA[$(CC_TOOL) $(DEFINES) $(INCLUDES) -w -MM -MP]]># Build rules$(TargetPath): $(IntDir) $(OutDir) $(OBJECTFILES)	@($(SHELL) -ec 'if [ "$(filter '%.a', '$(TargetPath)')" != "" ]; then echo "Archiving $(TargetPath)"; else echo "Linking $(TargetPath)"; fi')	@($(LINK))	@(echo "Done.")$(IntDir):	@(mkdir -p "$(IntDir)")	$(OutDir):	@(mkdir -p "$(OutDir)")$(IntDir)/%.o:	@(echo "Compiling $(filter %/$*.cpp %/$*.c, $(SOURCEFILES))")	@($(SHELL) -ec 'if [ "$(filter %/$*.cpp, $(SOURCEFILES))" != "" ]; \		then $(CPP_COMPILE) "$(filter %/$*.cpp, $(SOURCEFILES))"; \		elif [ "$(filter %/$*.c, $(SOURCEFILES))" != "" ]; \		then $(CC_COMPILE) "$(filter %/$*.c, $(SOURCEFILES))"; \		fi')ifneq "$(MAKECMDGOALS)" "clean"-include $(OBJECTFILES:%.o=%.d)endif$(IntDir)/%.d: $(IntDir)	<![CDATA[@($(SHELL) -ec 'if ! $(MAKEDEPEND) -MT "$(IntDir)/$(*F).o $(IntDir)/$(*F).d" "$(filter %/$*.cpp %/$*.c, $(SOURCEFILES))" > "$(IntDir)/$(*F).d"; then rm "$(IntDir)/$(*F).d"; fi')]]>clean:	-rm -f $(TargetPath)	-rm -f $(IntDir)/*.d	-rm -f $(IntDir)/*.o	rebuild: clean $(TargetPath)	endif                               	</xsl:for-each></xsl:template><!-- ========================================================= --><!-- template: objectFiles									   --><!-- ========================================================= --><xsl:template name="objectFiles">    <xsl:for-each select="//Filter[@Name!='Win32' and @Name!='Xenon']/File">		<xsl:variable name="suffix">			<xsl:call-template name="substringAfterLast">				<xsl:with-param name="text" select="@RelativePath" />				<xsl:with-param name="delimiter" select="'.'" />			</xsl:call-template>		</xsl:variable>		<xsl:if test="$suffix='cpp' or $suffix='c'">$(IntDir)/<xsl:call-template name="substringAfterLast">				<xsl:with-param name="text" select="substring-before(@RelativePath, concat('.', $suffix))" />				<xsl:with-param name="delimiter" select="string('\')" />			</xsl:call-template>.o \		</xsl:if> 	</xsl:for-each></xsl:template><!-- ========================================================= --><!-- template: sourceFiles									   --><!-- ========================================================= --><xsl:template name="sourceFiles">    <xsl:for-each select="//Filter[@Name!='Win32' and @Name!='Xenon']/File">		<xsl:variable name="suffix">			<xsl:call-template name="substringAfterLast">				<xsl:with-param name="text" select="@RelativePath" />				<xsl:with-param name="delimiter" select="'.'" />			</xsl:call-template>		</xsl:variable>		<xsl:if test="$suffix='cpp' or $suffix='c'">			<xsl:if test="substring(@RelativePath,1,2)!='.\' and substring(@RelativePath,1,3)!='..\'"><![CDATA[./]]></xsl:if><xsl:value-of select="translate(@RelativePath, '\', '/')" /> \		</xsl:if>	 	</xsl:for-each></xsl:template><!-- ========================================================= --><!-- template: processDefines								   --><!-- ========================================================= --><xsl:template name="processDefines">    <xsl:param name="definesString" />    <xsl:if test="string-length($definesString) != 0">	    <xsl:variable name="currentDefine">		    <xsl:choose>		        <xsl:when test="contains($definesString, ';')">			        <xsl:value-of select="substring-before($definesString,';')"/>   			    </xsl:when>				<xsl:when test="contains($definesString, ',')">					<xsl:value-of select="substring-before($definesString,',')"/>				</xsl:when>				<xsl:otherwise>				    <xsl:value-of select="$definesString" />				</xsl:otherwise>			</xsl:choose>		</xsl:variable>		<!-- eliminate Windows platform defines, append others -->		<xsl:choose>		    <xsl:when test="$currentDefine='WIN32'" />			<xsl:when test="$currentDefine='_WINDOWS'" />			<xsl:when test="$currentDefine='_USRDLL'" />			<xsl:when test="$currentDefine='_LIB'" />			<xsl:otherwise>			    <xsl:value-of select="concat(' -D', $currentDefine)" />			</xsl:otherwise>		</xsl:choose>		<xsl:choose>			<xsl:when test="contains($definesString, ';')">				<xsl:call-template name="processDefines">					<xsl:with-param name="definesString" select="substring-after($definesString, ';')" />				</xsl:call-template>			</xsl:when>			<xsl:when test="contains($definesString, ',')">				<xsl:call-template name="processDefines">					<xsl:with-param name="definesString" select="substring-after($definesString, ',')" />				</xsl:call-template>			</xsl:when>		</xsl:choose>    </xsl:if></xsl:template><!-- ========================================================= --><!-- template: processIncludePaths							   --><!-- ========================================================= --><xsl:template name="processIncludePaths">    <xsl:param name="includePathsString" />    <xsl:if test="string-length($includePathsString) != 0">	    <xsl:variable name="currentIncludePath">		    <xsl:choose>		        <xsl:when test="contains($includePathsString, ';')">			        <xsl:value-of select="substring-before($includePathsString,';')"/>   			    </xsl:when>		        <xsl:when test="contains($includePathsString, ',')">			        <xsl:value-of select="substring-before($includePathsString,',')"/>   			    </xsl:when>								<xsl:otherwise>				    <xsl:value-of select="$includePathsString" />				</xsl:otherwise>			</xsl:choose>		</xsl:variable>		   		<!-- replace/eliminate Windows platform include paths, append others -->		<xsl:choose>		    <xsl:when test="contains($currentIncludePath, 'Havok23Win32\include')"> -I$(HAVOK_INCLUDE_PATH)</xsl:when>			<xsl:otherwise>			    <xsl:value-of select="concat(' -I', translate($currentIncludePath, '\', '/'))" />			</xsl:otherwise>		</xsl:choose>		<xsl:choose>			<xsl:when test="contains($includePathsString, ';')">				<xsl:call-template name="processIncludePaths">					<xsl:with-param name="includePathsString" select="substring-after($includePathsString, ';')" />				</xsl:call-template>			</xsl:when>			<xsl:when test="contains($includePathsString, ',')">				<xsl:call-template name="processIncludePaths">					<xsl:with-param name="includePathsString" select="substring-after($includePathsString, ',')" />				</xsl:call-template>			</xsl:when>		</xsl:choose>			    </xsl:if></xsl:template><!-- ========================================================= --><!-- template: processLibraryPaths							   --><!-- ========================================================= --><xsl:template name="processLibraryPaths">    <xsl:param name="libraryPathsString" />    <xsl:if test="string-length($libraryPathsString) != 0">	<xsl:variable name="currentLibraryPath">		<xsl:choose>		        <xsl:when test="contains($libraryPathsString, ';')"><!--			        <xsl:value-of select="substring-before($libraryPathsString,';')"/> -->				<xsl:call-template name="convertPath">          				<xsl:with-param name="text" select="substring-before($libraryPathsString,';')" />       				</xsl:call-template>			</xsl:when>		        <xsl:when test="contains($libraryPathsString, ',')"><!--			        <xsl:value-of select="substring-before($libraryPathsString,',')"/> -->				<xsl:call-template name="convertPath">          				<xsl:with-param name="text" select="substring-before($libraryPathsString,',')" />       				</xsl:call-template>			</xsl:when>							<xsl:otherwise><!--			    	<xsl:value-of select="$libraryPathsString" /> -->				<xsl:call-template name="convertPath">          				<xsl:with-param name="text" select="$libraryPathsString" />       				</xsl:call-template>			</xsl:otherwise>		</xsl:choose>	</xsl:variable>	   		<!-- replace/eliminate Windows platform library paths, append others -->		<xsl:choose>		    <xsl:when test="contains($currentLibraryPath,'Havok23Win32\lib\win32-net\debug')"> -L$(HAVOK_DEBUG_LIB_PATH)</xsl:when>		    <xsl:when test="contains($currentLibraryPath,'Havok23Win32\lib\win32-net\release')"> -L$(HAVOK_RELEASE_LIB_PATH)</xsl:when>			<xsl:otherwise>			    <xsl:value-of select="concat(' -L', translate($currentLibraryPath, '\', '/'))" />			</xsl:otherwise>		</xsl:choose>		<xsl:choose>			<xsl:when test="contains($libraryPathsString, ';')">				<xsl:call-template name="processLibraryPaths">					<xsl:with-param name="libraryPathsString" select="substring-after($libraryPathsString, ';')" />				</xsl:call-template>			</xsl:when>			<xsl:when test="contains($libraryPathsString, ',')">				<xsl:call-template name="processLibraryPaths">					<xsl:with-param name="libraryPathsString" select="substring-after($libraryPathsString, ',')" />				</xsl:call-template>			</xsl:when>		</xsl:choose>						    </xsl:if></xsl:template><!-- ========================================================= --><!-- template: processLibraries                                --><!-- ========================================================= --><xsl:template name="processLibraries">    <xsl:param name="librariesString" />    <xsl:if test="string-length($librariesString) != 0">	    <xsl:variable name="currentLibrary">		    <xsl:choose>		        <xsl:when test="contains($librariesString, ' ')">			        <xsl:value-of select="substring-before($librariesString,' ')"/>   			    </xsl:when>				<xsl:otherwise>				    <xsl:value-of select="$librariesString" />				</xsl:otherwise>			</xsl:choose>		</xsl:variable>		<!-- replace/eliminate Windows platform libraries, special handling for Havok libraries, append -->		<!-- others modified for linux platform 														-->		<xsl:choose>		    <xsl:when test="$currentLibrary='winmm.lib'" />		    <xsl:when test="$currentLibrary='dplayx.lib'" />		    <xsl:when test="$currentLibrary='odbc32.lib'" />		    <xsl:when test="$currentLibrary='odbccp32.lib'" />			<xsl:when test="$currentLibrary='dxguid.lib'" />			<xsl:when test="$currentLibrary='hkutilities2.lib'">-Wl,--whole-archive -lhkvehicle2 -Wl,--no-whole-archive \			-Wl,--whole-archive <xsl:value-of select="concat('-l', substring-before($currentLibrary, '.lib'))" /> -Wl,--no-whole-archive \</xsl:when>			<xsl:when test="substring($currentLibrary,1,2)='hk'">			-Wl,--whole-archive <xsl:value-of select="concat('-l', substring-before($currentLibrary, '.lib'))" /> -Wl,--no-whole-archive \</xsl:when>			<xsl:when test="$currentLibrary='Shared_GameSpySDK.lib'">-Wl,--whole-archive -lShared_GameSpySDK -Wl,--no-whole-archive \			</xsl:when>			<xsl:when test="$currentLibrary='Engine_ZLib.lib'">			-Wl,--whole-archive -lEngine_ZLib -Wl,--no-whole-archive </xsl:when>			<xsl:otherwise>			    <xsl:value-of select="concat(' -l', substring-before($currentLibrary, '.lib'))" />			</xsl:otherwise>		</xsl:choose>		<xsl:call-template name="processLibraries">		   <xsl:with-param name="librariesString" select="substring-after($librariesString, ' ')" />		</xsl:call-template>    </xsl:if></xsl:template><!-- ========================================================= --><!-- template: processTargetPath							   --><!-- ========================================================= --><xsl:template name="processTargetPath">	<xsl:param name="targetPath" />		<xsl:variable name="fileSuffix">		<xsl:call-template name="substringAfterLast">			<xsl:with-param name="text" select="$targetPath" />			<xsl:with-param name="delimiter" select="'.'" />		</xsl:call-template>	</xsl:variable>		<xsl:variable name="targetPathWithoutFileSuffix" select="substring-before(translate($targetPath,'\','/'), concat('.',$fileSuffix))" />	<xsl:variable name="targetPathWithoutFile" select="substring-before($targetPathWithoutFileSuffix ,'/')" />	<xsl:variable name="fileNameWithoutSuffix">		<xsl:call-template name="substringAfterLast">			<xsl:with-param name="text" select="$targetPathWithoutFileSuffix" />			<xsl:with-param name="delimiter" select="'/'" />		</xsl:call-template>	</xsl:variable>			<xsl:choose>		<xsl:when test="$fileSuffix='dll'"><xsl:value-of select="$targetPathWithoutFile" />/lib<xsl:value-of select="$fileNameWithoutSuffix" />.so</xsl:when>		<xsl:when test="$fileSuffix='lto'"><xsl:value-of select="$targetPathWithoutFile" />/lib<xsl:value-of select="$fileNameWithoutSuffix" />.so</xsl:when>		<xsl:when test="$fileSuffix='lib'"><xsl:value-of select="$targetPathWithoutFile" />/lib<xsl:value-of select="$fileNameWithoutSuffix" />.a</xsl:when>		<xsl:when test="$fileSuffix='exe'"><xsl:value-of select="$targetPathWithoutFileSuffix" /></xsl:when>		<xsl:otherwise><xsl:value-of select="translate($targetPath, '\', '/')" /></xsl:otherwise>	</xsl:choose></xsl:template>	<!-- ========================================================= --><!-- template: replaceString								   --><!-- ========================================================= --><xsl:template name="replaceString">    <xsl:param name="text" />    <xsl:param name="replace" />    <xsl:param name="with" />	<xsl:choose>	   <xsl:when test="contains($text, $replace)">	       <xsl:value-of select="substring-before($text, $replace)"/>           <xsl:value-of select="$with"/>           <xsl:call-template name="replaceString">               <xsl:with-param name="text" select="substring-after($text, $replace)"/>               <xsl:with-param name="replace" select="$replace" />			   <xsl:with-param name="with" select="$with" />          </xsl:call-template>       </xsl:when>       <xsl:otherwise>          <xsl:value-of select="$text"/>       </xsl:otherwise>    </xsl:choose></xsl:template><!-- ========================================================= --><!-- template: substringAfterLast							   --><!-- ========================================================= --><xsl:template name="substringAfterLast">  <xsl:param name="text" />  <xsl:param name="delimiter" />  <xsl:choose>    <xsl:when test="contains($text, $delimiter)">      <xsl:call-template name="substringAfterLast">        <xsl:with-param name="text"          select="substring-after($text, $delimiter)" />        <xsl:with-param name="delimiter" select="$delimiter" />      </xsl:call-template>    </xsl:when>    <xsl:otherwise><xsl:value-of select="$text" /></xsl:otherwise>  </xsl:choose></xsl:template><!-- ========================================================= --><!-- template: convertPath                                     --><!-- ========================================================= --><xsl:template name="convertPath">  <xsl:param name="text" />  <xsl:choose>    <xsl:when test="contains($text, 'Debug7' )">      <xsl:call-template name="replaceString">        <xsl:with-param name="text" select="$text" />        <xsl:with-param name="replace" select="'Debug7'" />        <xsl:with-param name="with" select="'DebugLinux'" />      </xsl:call-template>    </xsl:when>    <xsl:when test="contains($text, 'Release7' )">      <xsl:call-template name="replaceString">        <xsl:with-param name="text" select="$text" />        <xsl:with-param name="replace" select="'Release7'" />        <xsl:with-param name="with" select="'ReleaseLinux'" />      </xsl:call-template>    </xsl:when>    <xsl:when test="contains($text, 'Final7' )">      <xsl:call-template name="replaceString">        <xsl:with-param name="text" select="$text" />        <xsl:with-param name="replace" select="'Final7'" />        <xsl:with-param name="with" select="'FinalLinux'" />      </xsl:call-template>    </xsl:when>    <xsl:when test="contains($text, 'Debug' )">      <xsl:call-template name="replaceString">        <xsl:with-param name="text" select="$text" />        <xsl:with-param name="replace" select="'Debug'" />        <xsl:with-param name="with" select="'DebugLinux'" />      </xsl:call-template>    </xsl:when>    <xsl:when test="contains($text, 'Release' )">      <xsl:call-template name="replaceString">        <xsl:with-param name="text" select="$text" />        <xsl:with-param name="replace" select="'Release'" />        <xsl:with-param name="with" select="'ReleaseLinux'" />      </xsl:call-template>    </xsl:when>    <xsl:when test="contains($text, 'Final' )">      <xsl:call-template name="replaceString">        <xsl:with-param name="text" select="$text" />        <xsl:with-param name="replace" select="'Final'" />        <xsl:with-param name="with" select="'FinalLinux'" />      </xsl:call-template>    </xsl:when>    <xsl:otherwise>      <xsl:value-of select="$text" />    </xsl:otherwise>  </xsl:choose></xsl:template></xsl:stylesheet>